# Production environment for browser-to-phone calling via Iagu
# Replace ${PUBLIC_IP} with your real static public IP before use.
# To activate: cp .env.production .env && npm run build

VITE_API_BASE_URL=https://${PUBLIC_IP}:3000
VITE_SIP_WSS_URL=wss://${PUBLIC_IP}:8089/ws
VITE_SIP_DOMAIN=${PUBLIC_IP}
VITE_SIP_USERNAME=venus
VITE_SIP_PASSWORD=Venus@2024!
VITE_TURN_URL=turn:${PUBLIC_IP}:3478
VITE_TURN_USERNAME=webrtc-user
VITE_TURN_PASSWORD=WebRTC@2024!
